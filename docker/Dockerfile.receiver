# Live evaluation-stream receiver.
#
#   docker build --network=host -f docker/Dockerfile.receiver -t archipelago-receiver:latest .
#   docker run --rm -p 9900:9900 archipelago-receiver:latest --every 250
#
# Deliberately carries nothing from this repository except the one script: a
# consumer of the log stream needs no harness code, no numpy and no pydantic,
# which is the decoupling principle of CLAUDE.md 7.7 made concrete. If this
# image can read the stream, so can anything else.
#
# Publishing the port is what makes it reachable. The master container runs with
# --network host, so it shares the host's network namespace and finds the
# receiver at 127.0.0.1:9900 -- the address this container's published port is
# bound to.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /archipelago

COPY scripts/stream_receiver.py ./stream_receiver.py

RUN useradd --create-home --uid 1000 archipelago
USER archipelago

EXPOSE 9900

ENTRYPOINT ["python", "stream_receiver.py", "--host", "0.0.0.0", "--port", "9900"]
