# Master/coordinator image.
#
# The default deployment runs everything in containers: this image runs the
# master, and the master creates one container per island from
# docker/Dockerfile.island.
#
#   docker build --network=host -f docker/Dockerfile.master -t archipelago-master:latest .
#   docker network create archipelago
#   docker run -d --name redis --network archipelago redis:7-alpine --maxmemory-policy noeviction
#   docker run --rm --network archipelago \
#     -v /var/run/docker.sock:/var/run/docker.sock \
#     -e ARCHIPELAGO_BROKER__URL=redis://redis:6379/0 \
#     archipelago-master:latest run --config config/docker_de_sphere.yaml
#
# Or let docker-compose.yml do all of that, with a dummy worker printing the stream.
#
# The run-time arguments are each load-bearing:
#
#   --network         a network where Redis is reachable. The master also creates a
#                     private network per run for its islands, and connects every
#                     island to the master's own networks, so islands reach Redis at
#                     the same URL. Do not use --network host: a container on the
#                     host network cannot join the run's network.
#   ARCHIPELAGO_BROKER__URL
#                     where every record goes. A password in it is redacted wherever
#                     the config is logged; islands receive the full config, real URL
#                     included, in their ISLAND_CONFIG environment variable.
#   docker.sock       the master creates and destroys sibling island containers,
#                     so it needs a daemon. This is Docker-outside-of-Docker: the
#                     islands are siblings of the master, not children. Nothing is
#                     shared through the filesystem: islands get their config by
#                     environment variable and report their result over the control
#                     channel.
#
# Mounting the Docker socket grants this container effective root on the host.
# That is a real trade, made knowingly: the alternative is running the master on
# the host with `python -m orchestrator.cli run`, which is fully supported and is
# what the tests do: the master on the host, each island still in a container.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/archipelago

WORKDIR /archipelago

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY archipelago_logging/ ./archipelago_logging/
COPY algorithms/ ./algorithms/
COPY benchmarks/ ./benchmarks/
COPY orchestrator/ ./orchestrator/
COPY config/ ./config/
COPY docker/ ./docker/
COPY requirements-island.txt ./

# Runs as root, deliberately: it needs to reach the mounted Docker socket, whose
# group id is not knowable at build time.
ENTRYPOINT ["python", "-m", "orchestrator.cli"]
CMD ["--help"]
