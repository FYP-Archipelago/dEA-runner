# Settings for the local stack (docker-compose.yml). Copy to .env, which is gitignored,
# and fill in. Compose reads .env by itself; nothing here goes on a command line.

# Password for the stack's Redis. The Runner, every master and island it starts, and the
# dummy worker get it from here.
REDIS_PASSWORD=change-me

# Ports on 127.0.0.1 where your own tools reach the stack: the Runner's API (the dummy
# backend) and Redis (the dummy backend's stream check, the memory measurement). 6379 is
# often taken by a Redis already on the machine.
RUNNER_HOST_PORT=8000
REDIS_HOST_PORT=6380
