# Settings for the local stack (docker-compose.yml). Copy to .env, which is gitignored,
# and fill in. Compose reads .env by itself; nothing here goes on a command line.

# Password for the stack's Redis. The master, every island and the dummy worker get it
# from here.
REDIS_PASSWORD=change-me

# The configs the master runs, one after another, separated by spaces. Paths are
# relative to the repository root; ./config is mounted into the master, so edited or
# new configs need no rebuild.
RUN_CONFIGS=config/docker_de_sphere.yaml

# Port on 127.0.0.1 where your own tools reach the stack's Redis (verify-log, the
# memory measurement). 6379 is often taken by a Redis already on the machine.
REDIS_HOST_PORT=6380
