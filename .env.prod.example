# Settings for the production Runner (docker-compose.prod.yml). Copy to .env.prod, which is
# gitignored, and fill in. Then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# The Archipelago Backend's Redis: every run's records go here. It must run with
# maxmemory-policy noeviction and keep ~0.8 GB free for runner streams, more while its workers
# read without a COUNT (docs/MEMORY_MEASUREMENTS.md). README.md ("Production") says what address
# to use where.
REDIS_URL=redis://:change-me@redis-host:6379/0

# Where the backend reaches the Runner's API. The Runner has no authentication, and ufw does not
# filter ports Docker publishes: use 127.0.0.1 or a private address, never a public one.
RUNNER_BIND=127.0.0.1
RUNNER_PORT=8000

# Optional. Each defaults as in docs/CONFIGURATION.md.
# MAX_CONCURRENT_RUNS=2
# RUN_TIME_LIMIT_SECONDS=3600
# BYE_TIMEOUT_SECONDS=20
# ISLAND_CPUS=1.0
# ISLAND_MEMORY=2g
